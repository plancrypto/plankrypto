@page
@model PlanKryptoWeb.Pages.IndexModel

<section class="page home-page">
    <section class="hero">
        <h1>PlanKrypto – Your Crypto Command Center</h1>
        <p>
            Real-time prices, smart alerts, and portfolio tracking in one place.
            DeFi and asset tokenization coming next.
        </p>
        <div class="hero-actions">
            <button class="btn btn-primary">Download App</button>
            <a asp-page="/Roadmap" class="btn btn-outline">View Roadmap</a>
        </div>
    </section>

    <section class="section">
        <h2>What You Can Do Today</h2>
        <div class="grid">
            <div class="card">
                <h3>Live Market Prices</h3>
                <p>Track BTC, ETH, and altcoins in real time.</p>
            </div>
            <div class="card">
                <h3>Smart Watchlists</h3>
                <p>Create watchlists and see market moves at a glance.</p>
            </div>
            <div class="card">
                <h3>Portfolio Tracking</h3>
                <p>Monitor holdings, P&amp;L, and allocation in one dashboard.</p>
            </div>
            <div class="card">
                <h3>Custom Alerts</h3>
                <p>Set price alerts and get notified when the market moves.</p>
            </div>
        </div>
    </section>

    <section class="section section-alt">
        <h2>Why PlanKrypto Is Different</h2>
        <ul class="list">
            <li>Built for both active traders and long-term holders.</li>
            <li>Designed to grow into DeFi and tokenization, not just a price app.</li>
            <li>Focus on clarity, risk awareness, and intelligent automation (future AI).</li>
        </ul>
    </section>

    <section class="section">
        <h2>What’s Coming Next</h2>
        <div class="grid">
            <div class="card">
                <h3>DeFi Modules</h3>
                <p>On-chain staking and lending via smart contracts.</p>
            </div>
            <div class="card">
                <h3>Advanced Analytics</h3>
                <p>Technical indicators and AI-assisted insights.</p>
            </div>
            <div class="card">
                <h3>Asset Tokenization</h3>
                <p>Long-term: tools for companies to bring tokenized “stock” to market.</p>
            </div>
        </div>
        <div class="center">
            <a asp-page="/Roadmap" class="btn btn-primary">Explore Full Roadmap</a>
        </div>
    </section>
</section>
