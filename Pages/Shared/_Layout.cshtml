@{
    var title = ViewData["Title"] as string ?? "PlanKrypto";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@title - PlanKrypto</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="navbar">
        <div class="nav-logo">PlanKrypto</div>
        <nav class="nav-links">
            <a asp-page="/Index" class="nav-link">Home</a>
            <a asp-page="/Roadmap" class="nav-link">Roadmap</a>
            <a asp-page="/About" class="nav-link">About</a>
        </nav>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div>© @DateTime.Now.Year PlanKrypto. All rights reserved.</div>
        <div class="footer-links">
            <a href="#terms">Terms</a>
            <a href="#privacy">Privacy</a>
            <a href="#risk">Risk Disclaimer</a>
        </div>
    </footer>
</body>
</html>
